{
  "schema_version": 1,
  "paths": {
    "bundle": "inputs",
    "runs": "runs/rxnpredict_pcs_v3"
  },
  "run": {
    "models": [
      "ligand_ohe",
      "selected_2",
      "selected_5",
      "pc_top",
      "pc_scores"
    ],
    "models_disabled": [
      "rxnpredict_full",
      "rxnpredict_full_ohe"
    ],
    "methods": [
      "lolo",
      "iid_stratified_4",
      "kfold_stratified_5",
      "kfold_5"
    ],
    "seed": 42,
    "stratify": true,
    "threads": 4
  },
  "gp": {
    "kernel": "RBF",
    "grouping": "all",
    "mixing_method": "product",
    "ard": true,
    "dtype": "float32",
    "noise": null,
    "noise_floor": 0.01,
    "outputscale": null,
    "train_jitter": 0.0001,
    "predict_jitter": 0.0001,
    "restarts": 1,
    "n_epochs": 400,
    "learning_rate": 0.01,
    "prior": true,
    "normalize_y": true,
    "use_cuda": true
  }
}
