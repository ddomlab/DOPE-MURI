{
  "schema_version": 1,
  "paths": {
    "bundle": "inputs",
    "runs": "runs/cernak_v1"
  },
  "run": {
    "models": [
      "catalyst_ohe"
    ],
    "methods": [
      "lolo",
      "kfold_stratified_5",
      "kfold_5"
    ],
    "seed": 42,
    "stratify": true,
    "threads": 4,
    "model_overrides": {}
  },
  "gp": {
    "kernel": "RBF",
    "grouping": "all",
    "mixing_method": "product",
    "ard": true,
    "dtype": "float32",
    "noise": null,
    "noise_floor": 0.01,
    "outputscale": null,
    "train_jitter": 0.0001,
    "predict_jitter": 0.0001,
    "restarts": 1,
    "n_epochs": 400,
    "learning_rate": 0.01,
    "prior": true,
    "normalize_y": true,
    "use_cuda": true
  }
}
