{
  "schema_version": 2,
  "dataset": "perera",
  "display_name": "Perera",
  "source": "https://raw.githubusercontent.com/Paulilein/Perera2018/main/Perera2018_Data_Original.csv",
  "data": {
    "target": "Product_Yield_PCT_Area_UV",
    "group": "ligand",
    "common_categorical": [
      "Reactant_1_Short_Hand",
      "Reagent_1_Short_Hand",
      "Solvent_1_Short_Hand",
      "substrate_pair"
    ],
    "expected_rows": 3072,
    "expected_groups": 8
  },
  "features": {
    "models": [
      "group_ohe",
      "selected_2",
      "vbur_min_vmin",
      "vbur_boltz_vmin",
      "selected_5",
      "pc_top",
      "pc_scores"
    ],
    "pca_reference": "full_original_kraken",
    "pca_components": 4,
    "top_per_pc": 3,
    "pc_scores_form": "component_scores",
    "ohe_policy": "train_ignore_unknown"
  },
  "evaluation": {
    "methods": [
      "lolo",
      "iid_stratified_8",
      "kfold_stratified_5",
      "kfold_5"
    ],
    "seed": 42,
    "stratify_on": "ligand"
  }
}
