{
  "schema_version": 1,
  "paths": {
    "bundle": "inputs",
    "runs": "runs/ard_v2"
  },
  "run": {
    "models": [
      "ligand_ohe",
      "selected_2",
      "selected_5",
      "pc_top",
      "pc_scores",
      "pc_scores_long"
    ],
    "methods": [
      "lolo",
      "iid_stratified_8",
      "kfold_stratified_5"
    ],
    "seed": 42,
    "stratify": true,
    "threads": 4,
    "model_overrides": {
      "pc_scores_long": {
        "n_epochs": 1600,
        "restarts": 3,
        "walltime": "02:00:00"
      }
    }
  },
  "gp": {
    "kernel": "RBF",
    "grouping": "all",
    "mixing_method": "product",
    "ard": true,
    "dtype": "float32",
    "noise": null,
    "noise_floor": 0.01,
    "outputscale": null,
    "train_jitter": 0.0001,
    "predict_jitter": 0.0001,
    "restarts": 1,
    "n_epochs": 400,
    "learning_rate": 0.01,
    "prior": true,
    "normalize_y": true,
    "use_cuda": true
  }
}
